APP_ENV=development
LOG_LEVEL=INFO
DEMO_MODE=true
DATABASE_URL=postgresql+psycopg://grievance:replace-for-local-development@localhost:5432/grievance
POSTGRES_PORT=5432
PORT=8000
API_PORT=8000
POSTGRES_DB=grievance
POSTGRES_USER=grievance
POSTGRES_PASSWORD=replace-for-local-development
JWT_SECRET=replace-with-a-random-secret-before-use
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
# Default is baseline; muril is optional; fake is for tests only.
CLASSIFIER_BACKEND=baseline
MODEL_NAME_OR_PATH=MayankLumbhani/hi02-muril-grievance
HF_TOKEN=
# Accept the top department at this confidence, or below it when the margin over the runner-up is large.
CLASSIFIER_ACCEPT_THRESHOLD=0.35
CLASSIFIER_MARGIN_THRESHOLD=0.12
CLASSIFIER_MARGIN_MIN_CONFIDENCE=0.25
TICKET_ID_PREFIX=FMC
LLM_ENABLED=false
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=replace-with-your-gemini-model
LLM_TIMEOUT_SECONDS=60
DATASET_SEED=20261031
DATASET_TIER1_SAMPLES_PER_CLASS_LANGUAGE=100
DATASET_TIER2_SAMPLES_PER_CLASS_LANGUAGE=30
DATASET_MINIMUM_STRATUM_FRACTION=0.9
ESCALATION_INTERVAL_SECONDS=60
RATE_LIMIT_CHAT=10/minute
RATE_LIMIT_STATUS=30/minute
MAX_MESSAGE_LENGTH=2000
DEMO_OFFICER_USERNAME=
DEMO_OFFICER_PASSWORD=
DEMO_OFFICER_DEPARTMENT_CODE=WATER
DEMO_ADMIN_USERNAME=
DEMO_ADMIN_PASSWORD=
